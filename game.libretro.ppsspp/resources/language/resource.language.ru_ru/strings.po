msgctxt "Addon Summary"
msgid "Sony - PlayStation Portable (PPSSPP)"
msgstr ""

msgctxt "Addon Description"
msgid "PPSSPP is a fast and portable PSP emulator written in C++."
msgstr "PPSSPP — это быстрый и переносимый эмулятор PSP, написанный на C++."

msgctxt "Addon Disclaimer"
msgid "Originally created by Henrik Rydgård"
msgstr "Изначально создан Хенриком Рюдгордом"

msgctxt "#30001"
msgid "CPU Core"
msgstr "Ядро ЦП"

msgctxt "#30002"
msgid "Locked CPU Speed"
msgstr "Фиксированная скорость ЦП"

msgctxt "#30005"
msgid "Auto Frameskip"
msgstr "Автоматический пропуск кадров"

msgctxt "#30006"
msgid "Frameskip"
msgstr "Пропуск кадров"

msgctxt "#30007"
msgid "Frameskip Type"
msgstr "Тип пропуска кадров"

msgctxt "#30010"
msgid "Confirmation Button"
msgstr "Кнопка подтверждения"

msgctxt "#30015"
msgid "Texture Filtering"
msgstr "Фильтрация текстур"

msgctxt "#30016"
msgid "Anisotropic Filtering"
msgstr "Анизотропная фильтрация"

msgctxt "#30017"
msgid "Texture Deposterize"
msgstr "Депостеризация текстур"

msgctxt "#30018"
msgid "Texture Replacement"
msgstr "Замена текстур"

msgctxt "#30022"
msgid "Internal Cheats Support"
msgstr "Поддержка внутренних читов"

msgctxt "#30024"
msgid "System"
msgstr "Система"

msgctxt "#30025"
msgid "Configure system options."
msgstr "Настройка параметров системы."

msgctxt "#30026"
msgid "Dynarec (JIT)"
msgstr "Dynarec (JIT)"

msgctxt "#30027"
msgid "IR Interpreter"
msgstr "IR-интерпретатор"

msgctxt "#30028"
msgid "Fast Memory"
msgstr "Быстрая память"

msgctxt "#30029"
msgid "Unstable."
msgstr "Нестабильно."

msgctxt "#30030"
msgid "Ignore Bad Memory Accesses"
msgstr "Игнорировать некорректные обращения к памяти"

msgctxt "#30031"
msgid "I/O Timing Method"
msgstr "Метод синхронизации ввода-вывода"

msgctxt "#30032"
msgid "Force Real Clock Sync"
msgstr "Принудительная синхронизация реальных часов"

msgctxt "#30033"
msgid "Slower, less lag."
msgstr "Медленнее, меньше задержек."

msgctxt "#30034"
msgid "Memory Stick Inserted"
msgstr "Карта памяти вставлена"

msgctxt "#30035"
msgid "Some games require ejecting/inserting the Memory Stick."
msgstr "Некоторые игры требуют извлечения/вставки карты памяти."

msgctxt "#30036"
msgid "Cache Full ISO in RAM"
msgstr "Кэшировать полный ISO в ОЗУ"

msgctxt "#30037"
msgid "Game Language"
msgstr "Язык игры"

msgctxt "#30038"
msgid "'Automatic' will use the frontend language."
msgstr "«Автоматически» будет использовать язык фронтенда."

msgctxt "#30039"
msgid "PSP Model"
msgstr "Модель PSP"

msgctxt "#30040"
msgid "PSP-1000"
msgstr "PSP-1000"

msgctxt "#30041"
msgid "PSP-2000/3000"
msgstr "PSP-2000/3000"

msgctxt "#30042"
msgid "Video"
msgstr "Видео"

msgctxt "#30043"
msgid "Configure video options."
msgstr "Настройка параметров видео."

msgctxt "#30044"
msgid "Backend"
msgstr "Бэкенд"

msgctxt "#30045"
msgid "'Automatic' will use the frontend video driver. Core restart required."
msgstr "«Автоматически» будет использовать видеодрайвер фронтенда. Требуется перезапуск ядра."

