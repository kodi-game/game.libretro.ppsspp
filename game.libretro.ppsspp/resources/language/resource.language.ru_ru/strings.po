msgid "9x (4320x2448)"
msgstr "9x (4320x2448)"

msgctxt "#30063"
msgid "10x (4800x2720)"
msgstr "10x (4800x2720)"

msgctxt "#30064"
msgid "MSAA Antialiasing"
msgstr "Сглаживание MSAA"

msgctxt "#30065"
msgid "Vulkan only. Core restart required."
msgstr "Только Vulkan. Требуется перезапуск ядра."

msgctxt "#30066"
msgid "Crop to 16x9"
msgstr "Обрезать до 16:9"

msgctxt "#30067"
msgid "Remove one line from top and bottom to get exact 16:9. Core restart required with Vulkan."
msgstr "Удалить по одной строке сверху и снизу, чтобы получить точное 16:9. Требуется перезапуск ядра с Vulkan."

msgctxt "#30068"
msgid "Render Duplicate Frames to 60 Hz"
msgstr "Отрисовывать дублированные кадры до 60 Гц"

msgctxt "#30069"
msgid "Can make framerate smoother in games that run at lower framerates."
msgstr "Может сделать частоту кадров более плавной в играх, работающих на более низкой частоте кадров."

msgctxt "#30070"
msgid "Detect Frame Rate Changes"
msgstr "Обнаруживать изменения частоты кадров"

msgctxt "#30071"
msgid "Notify frontend."
msgstr "Уведомлять фронтенд."

msgctxt "#30072"
msgid "Buffer Graphics Commands"
msgstr "Буферизовать графические команды"

msgctxt "#30073"
msgid "GL/Vulkan only, slower, less lag, restart."
msgstr "Только GL/Vulkan, медленнее, меньше задержек, перезапуск."

msgctxt "#30074"
msgid "Hardware Transform"
msgstr "Аппаратное преобразование"

msgctxt "#30075"
msgid "Software Skinning"
msgstr "Программная скелетная анимация"

msgctxt "#30076"
msgid "Combine skinned model draws on the CPU, faster in most games."
msgstr "Объединять отрисовки моделей со скелетной анимацией на ЦП, быстрее в большинстве игр."

msgctxt "#30077"
msgid "Hardware Tesselation"
msgstr "Аппаратная тесселяция"

msgctxt "#30078"
msgid "Uses hardware to make curves."
msgstr "Использует оборудование для создания кривых."

msgctxt "#30079"
msgid "Texture Upscale Type"
msgstr "Тип масштабирования текстур"

msgctxt "#30080"
msgid "xBRZ"
msgstr "xBRZ"

msgctxt "#30081"
msgid "Hybrid"
msgstr "Гибридный"

msgctxt "#30082"
msgid "Bicubic"
msgstr "Бикубический"

msgctxt "#30083"
msgid "Hybrid + Bicubic"
msgstr "Гибридный + бикубический"

msgctxt "#30084"
msgid "Texture Upscaling Level"
msgstr "Уровень масштабирования текстур"

msgctxt "#30085"
msgid "CPU heavy, some scaling may be delayed to avoid stutter."
msgstr "Нагружает ЦП, некоторое масштабирование может быть отложено, чтобы избежать подтормаживаний."

msgctxt "#30086"
msgid "Fixes visual banding glitches in upscaled textures."
msgstr "Исправляет визуальные сбои полосности в масштабированных текстурах."

msgctxt "#30087"
msgid "Texture Shader"
msgstr "Шейдер текстур"

msgctxt "#30088"
msgid "Vulkan only, overrides 'Texture Scaling Type'."
msgstr "Только Vulkan, переопределяет «Тип масштабирования текстур»."

msgctxt "#30089"
msgid "Tex2xBRZ"
msgstr "Tex2xBRZ"

msgctxt "#30090"
msgid "Tex4xBRZ"
msgstr "Tex4xBRZ"

msgctxt "#30091"
msgid "TexMMPX"
msgstr "TexMMPX"

msgctxt "#30092"
msgid "Smart 2D Texture Filtering"
msgstr "Умная фильтрация 2D-текстур"

msgctxt "#30093"
msgid "Gets rid of some visual artifacts caused by unnecessary texture filtering in some 2D games, by switching to nearest filtering."
msgstr "Избавляется от некоторых визуальных артефактов, вызванных ненужной фильтрацией текстур в некоторых 2D-играх, путём переключения на фильтрацию «ближайший сосед»."

msgctxt "#30094"
msgid "Input"
msgstr "Ввод"

msgctxt "#30095"
msgid "Configure input options."
msgstr "Настройка параметров ввода."

msgctxt "#30096"
msgid "Analog Circle vs Square Gate Compensation"
msgstr "Компенсация круглого и квадратного ограничителя аналога"

msgctxt "#30097"
msgid "Analog Deadzone"
msgstr "Мёртвая зона аналога"

msgctxt "#30098"
msgid "Additional deadzone to apply after frontend input."
msgstr "Дополнительная мёртвая зона, применяемая после ввода фронтенда."

