msgid "Analog Axis Scale"
msgstr "Масштаб аналоговой оси"

msgctxt "#30111"
msgid "Additional sensitivity factor to apply after frontend input."
msgstr "Дополнительный коэффициент чувствительности, применяемый после ввода фронтенда."

msgctxt "#30112"
msgid "Hacks"
msgstr "Хаки"

msgctxt "#30113"
msgid "Configure speed and emulation hacks. Can cause rendering errors!"
msgstr "Настройка хаков скорости и эмуляции. Может вызвать ошибки отрисовки!"

msgctxt "#30114"
msgid "Skip Buffer Effects"
msgstr "Пропускать эффекты буфера"

msgctxt "#30115"
msgid "Faster, but nothing may draw in some games."
msgstr "Быстрее, но в некоторых играх может ничего не отрисоваться."

msgctxt "#30116"
msgid "Skip GPU Readbacks"
msgstr "Пропускать обратные чтения ГП"

msgctxt "#30117"
msgid "Some games require GPU readbacks, so be careful."
msgstr "Некоторые игры требуют обратных чтений ГП, будьте осторожны."

msgctxt "#30118"
msgid "Lazy Texture Caching (Speedup)"
msgstr "Ленивое кэширование текстур (ускорение)"

msgctxt "#30119"
msgid "Faster, but can cause text problems in a few games."
msgstr "Быстрее, но может вызвать проблемы с текстом в нескольких играх."

msgctxt "#30120"
msgid "Spline/Bezier Curves Quality"
msgstr "Качество сплайновых/кривых Безье"

msgctxt "#30121"
msgid "Only used by some games, controls smoothness of curves."
msgstr "Используется только некоторыми играми, управляет плавностью кривых."

msgctxt "#30122"
msgid "Lower Resolution for Effects"
msgstr "Пониженное разрешение для эффектов"

msgctxt "#30123"
msgid "Reduces artifacts."
msgstr "Уменьшает артефакты."

