msgid "None"
msgstr "Нет"

msgctxt "#30050"
msgid "Software Rendering"
msgstr "Программная отрисовка"

msgctxt "#30051"
msgid "Slow, accurate. Core restart required."
msgstr "Медленно, точно. Требуется перезапуск ядра."

msgctxt "#30052"
msgid "Rendering Resolution"
msgstr "Разрешение отрисовки"

msgctxt "#30053"
msgid "Core restart required with Vulkan."
msgstr "Требуется перезапуск ядра с Vulkan."

