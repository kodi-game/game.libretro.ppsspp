msgid "Software Rendering"
msgstr "Softwarové vykreslování"

msgctxt "#30051"
msgid "Slow, accurate. Core restart required."
msgstr "Pomalé, přesné. Vyžaduje restart jádra."

msgctxt "#30052"
msgid "Rendering Resolution"
msgstr "Rozlišení vykreslování"

msgctxt "#30053"
msgid "Core restart required with Vulkan."
msgstr "Při použití rozhraní Vulkan je vyžadován restart jádra."

