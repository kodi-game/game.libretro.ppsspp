msgid "I/O Timing Method"
msgstr "Metoda časování vstupu/výstupu"

msgctxt "#30032"
msgid "Force Real Clock Sync"
msgstr "Vynutit synchronizaci se skutečnými hodinami"

msgctxt "#30033"
msgid "Slower, less lag."
msgstr "Pomalejší, menší prodleva."

msgctxt "#30034"
msgid "Memory Stick Inserted"
msgstr "Karta Memory Stick vložena"

msgctxt "#30035"
msgid "Some games require ejecting/inserting the Memory Stick."
msgstr "Některé hry vyžadují vysunutí nebo vložení karty Memory Stick."

msgctxt "#30036"
msgid "Cache Full ISO in RAM"
msgstr "Uložit celý obraz ISO do mezipaměti RAM"

msgctxt "#30037"
msgid "Game Language"
msgstr "Jazyk hry"

msgctxt "#30038"
msgid "'Automatic' will use the frontend language."
msgstr "Při nastavení „Automaticky“ se použije jazyk frontendu."

msgctxt "#30039"
msgid "PSP Model"
msgstr "Model PSP"

msgctxt "#30040"
msgid "PSP-1000"
msgstr "PSP-1000"

