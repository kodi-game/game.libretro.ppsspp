msgctxt "Addon Summary"
msgid "Sony - PlayStation Portable (PPSSPP)"
msgstr ""

msgctxt "Addon Description"
msgid "PPSSPP is a fast and portable PSP emulator written in C++."
msgstr "PPSSPP je rychlý a přenositelný emulátor PSP napsaný v C++."

msgctxt "Addon Disclaimer"
msgid "Originally created by Henrik Rydgård"
msgstr "Původně vytvořil Henrik Rydgård"

msgctxt "#30001"
msgid "CPU Core"
msgstr "Jádro CPU"

msgctxt "#30002"
msgid "Locked CPU Speed"
msgstr "Uzamčená rychlost CPU"

msgctxt "#30005"
msgid "Auto Frameskip"
msgstr "Automatické přeskakování snímků"

