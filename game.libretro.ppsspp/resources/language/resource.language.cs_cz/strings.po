msgstr "PSP-2000/3000"

msgctxt "#30042"
msgid "Video"
msgstr "Video"

msgctxt "#30043"
msgid "Configure video options."
msgstr "Nastavení možností obrazu."

msgctxt "#30044"
msgid "Backend"
msgstr "Grafické rozhraní"

msgctxt "#30045"
msgid "'Automatic' will use the frontend video driver. Core restart required."
msgstr "Při nastavení „Automaticky“ se použije ovladač obrazu frontendu. Vyžaduje restart jádra."

