msgid "Configure system options."
msgstr "Nastavení možností systému."

msgctxt "#30026"
msgid "Dynarec (JIT)"
msgstr "Dynamický rekompilátor (JIT)"

msgctxt "#30027"
msgid "IR Interpreter"
msgstr "Interpret IR"

msgctxt "#30028"
msgid "Fast Memory"
msgstr "Rychlá paměť"

msgctxt "#30029"
msgid "Unstable."
msgstr "Nestabilní."

msgctxt "#30030"
msgid "Ignore Bad Memory Accesses"
msgstr "Ignorovat neplatné přístupy do paměti"

