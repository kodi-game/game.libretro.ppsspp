msgctxt "#30111"
msgid "Additional sensitivity factor to apply after frontend input."
msgstr "Dodatečný faktor citlivosti použitý po zpracování vstupu frontendem."

msgctxt "#30112"
msgid "Hacks"
msgstr "Hacky"

msgctxt "#30113"
msgid "Configure speed and emulation hacks. Can cause rendering errors!"
msgstr "Nastavení hacků rychlosti a emulace. Mohou způsobit chyby vykreslování!"

msgctxt "#30114"
msgid "Skip Buffer Effects"
msgstr "Přeskakovat efekty vyrovnávací paměti"

msgctxt "#30115"
msgid "Faster, but nothing may draw in some games."
msgstr "Rychlejší, ale v některých hrách se nemusí nic vykreslit."

msgctxt "#30116"
msgid "Skip GPU Readbacks"
msgstr "Přeskakovat zpětná čtení z GPU"

msgctxt "#30117"
msgid "Some games require GPU readbacks, so be careful."
msgstr "Některé hry vyžadují zpětná čtení z GPU, proto buďte opatrní."

msgctxt "#30118"
msgid "Lazy Texture Caching (Speedup)"
msgstr "Odložené ukládání textur do mezipaměti (zrychlení)"

msgctxt "#30119"
msgid "Faster, but can cause text problems in a few games."
msgstr "Rychlejší, ale v několika hrách může způsobit problémy s textem."

msgctxt "#30120"
msgid "Spline/Bezier Curves Quality"
msgstr "Kvalita spline/Bézierových křivek"

msgctxt "#30121"
msgid "Only used by some games, controls smoothness of curves."
msgstr "Používá se pouze v některých hrách a určuje hladkost křivek."

msgctxt "#30122"
msgid "Lower Resolution for Effects"
msgstr "Nižší rozlišení efektů"

msgctxt "#30123"
msgid "Reduces artifacts."
msgstr "Omezuje artefakty."

