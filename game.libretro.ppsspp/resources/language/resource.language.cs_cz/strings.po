msgid "9x (4320x2448)"
msgstr "9× (4320×2448)"

msgctxt "#30063"
msgid "10x (4800x2720)"
msgstr "10× (4800×2720)"

msgctxt "#30064"
msgid "MSAA Antialiasing"
msgstr "Vyhlazování MSAA"

msgctxt "#30065"
msgid "Vulkan only. Core restart required."
msgstr "Pouze Vulkan. Vyžaduje restart jádra."

msgctxt "#30066"
msgid "Crop to 16x9"
msgstr "Oříznout na 16:9"

msgctxt "#30067"
msgid "Remove one line from top and bottom to get exact 16:9. Core restart required with Vulkan."
msgstr "Odebere jeden řádek nahoře a dole, aby se dosáhlo přesného poměru 16:9. Při použití rozhraní Vulkan je vyžadován restart jádra."

msgctxt "#30068"
msgid "Render Duplicate Frames to 60 Hz"
msgstr "Vykreslovat duplicitní snímky při 60 Hz"

msgctxt "#30069"
msgid "Can make framerate smoother in games that run at lower framerates."
msgstr "Může zajistit plynulejší snímkovou frekvenci ve hrách, které běží s nižší snímkovou frekvencí."

msgctxt "#30070"
msgid "Detect Frame Rate Changes"
msgstr "Zjišťovat změny snímkové frekvence"

msgctxt "#30071"
msgid "Notify frontend."
msgstr "Upozorní frontend."

msgctxt "#30072"
msgid "Buffer Graphics Commands"
msgstr "Ukládat grafické příkazy do vyrovnávací paměti"

msgctxt "#30073"
msgid "GL/Vulkan only, slower, less lag, restart."
msgstr "Pouze GL/Vulkan; pomalejší, s menší prodlevou; vyžaduje restart."

msgctxt "#30074"
msgid "Hardware Transform"
msgstr "Hardwarová transformace"

msgctxt "#30075"
msgid "Software Skinning"
msgstr "Softwarový skinning"

msgctxt "#30076"
msgid "Combine skinned model draws on the CPU, faster in most games."
msgstr "Slučuje vykreslování modelů se skinningem na CPU; ve většině her je rychlejší."

msgctxt "#30077"
msgid "Hardware Tesselation"
msgstr "Hardwarová teselace"

msgctxt "#30078"
msgid "Uses hardware to make curves."
msgstr "K vytváření křivek používá hardware."

msgctxt "#30079"
msgid "Texture Upscale Type"
msgstr "Typ zvětšování textur"

msgctxt "#30080"
msgid "xBRZ"
msgstr "xBRZ"

msgctxt "#30081"
msgid "Hybrid"
msgstr "Hybridní"

msgctxt "#30082"
msgid "Bicubic"
msgstr "Bikubické"

msgctxt "#30083"
msgid "Hybrid + Bicubic"
msgstr "Hybridní + bikubické"

msgctxt "#30084"
msgid "Texture Upscaling Level"
msgstr "Úroveň zvětšování textur"

msgctxt "#30085"
msgid "CPU heavy, some scaling may be delayed to avoid stutter."
msgstr "Vysoká zátěž CPU; některé zvětšování může být odloženo, aby se předešlo zadrhávání."

msgctxt "#30086"
msgid "Fixes visual banding glitches in upscaled textures."
msgstr "Opravuje vady v podobě barevných pruhů ve zvětšených texturách."

msgctxt "#30087"
msgid "Texture Shader"
msgstr "Shader textur"

msgctxt "#30088"
msgid "Vulkan only, overrides 'Texture Scaling Type'."
msgstr "Pouze Vulkan; přepíše nastavení „Typ zvětšování textur“."

msgctxt "#30089"
msgid "Tex2xBRZ"
msgstr "Tex2xBRZ"

msgctxt "#30090"
msgid "Tex4xBRZ"
msgstr "Tex4xBRZ"

msgctxt "#30091"
msgid "TexMMPX"
msgstr "TexMMPX"

msgctxt "#30092"
msgid "Smart 2D Texture Filtering"
msgstr "Inteligentní filtrování 2D textur"

msgctxt "#30093"
msgid "Gets rid of some visual artifacts caused by unnecessary texture filtering in some 2D games, by switching to nearest filtering."
msgstr "Přepnutím na filtrování nejbližšího bodu odstraňuje některé obrazové artefakty způsobené zbytečným filtrováním textur v některých 2D hrách."

msgctxt "#30094"
msgid "Input"
msgstr "Vstup"

msgctxt "#30095"
msgid "Configure input options."
msgstr "Nastavení možností vstupu."

msgctxt "#30096"
msgid "Analog Circle vs Square Gate Compensation"
msgstr "Kompenzace rozdílu mezi kruhovým a čtvercovým omezením analogu"

msgctxt "#30097"
msgid "Analog Deadzone"
msgstr "Mrtvá zóna analogu"

msgctxt "#30098"
msgid "Additional deadzone to apply after frontend input."
msgstr "Dodatečná mrtvá zóna použitá po zpracování vstupu frontendem."

